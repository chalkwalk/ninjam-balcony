# /etc/ninjam/balcony.env -- root:root 0600. Read by balcony.service.
# The balcony's own account, which /etc/ninjam/improv.cfg gives chat and H:
#   User balcony <password> CH
BALCONY_PASSWORD=change-me
# Logged-in names whose "balcony, kick <name>" and "balcony, quiet" are obeyed.
BALCONY_ADMINS=chalkwalk
